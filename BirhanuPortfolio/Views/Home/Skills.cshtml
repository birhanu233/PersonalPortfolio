@{
    ViewData["Title"] = "Skills";
}

<section class="page-section">

    <div class="container">

        <div class="section-heading text-center">

            <p class="section-small-title">
                MY TECHNICAL BACKGROUND
            </p>

            <h1>
                Skills
            </h1>

        </div>


        <div class="row mt-5">


            <!-- .NET -->

            <div class="col-md-6 mb-4">

                <div class="skill-card">

                    <h4>
                        C# / .NET
                    </h4>

                    <div class="progress">

                        <div class="progress-bar"
                             style="width: 85%;">

                            85%

                        </div>

                    </div>

                </div>

            </div>


            <!-- ASP.NET -->

            <div class="col-md-6 mb-4">

                <div class="skill-card">

                    <h4>
                        ASP.NET Core
                    </h4>

                    <div class="progress">

                        <div class="progress-bar"
                             style="width: 80%;">

                            80%

                        </div>

                    </div>

                </div>

            </div>


            <!-- SQL -->

            <div class="col-md-6 mb-4">

                <div class="skill-card">

                    <h4>
                        SQL Server
                    </h4>

                    <div class="progress">

                        <div class="progress-bar"
                             style="width: 85%;">

                            85%

                        </div>

                    </div>

                </div>

            </div>


            <!-- Core Banking -->

            <div class="col-md-6 mb-4">

                <div class="skill-card">

                    <h4>
                        Core Banking Systems
                    </h4>

                    <div class="progress">

                        <div class="progress-bar"
                             style="width: 75%;">

                            75%

                        </div>

                    </div>

                </div>

            </div>


            <!-- Python -->

            <div class="col-md-6 mb-4">

                <div class="skill-card">

                    <h4>
                        Python / Django
                    </h4>

                    <div class="progress">

                        <div class="progress-bar"
                             style="width: 70%;">

                            70%

                        </div>

                    </div>

                </div>

            </div>


            <!-- Flutter -->

            <div class="col-md-6 mb-4">

                <div class="skill-card">

                    <h4>
                        Flutter
                    </h4>

                    <div class="progress">

                        <div class="progress-bar"
                             style="width: 65%;">

                            65%

                        </div>

                    </div>

                </div>

            </div>


        </div>

    </div>

</section>